#!/bin/sh

# Recompute the status-line truncation width for every window, based on
# the number of windows in its session and the window width.  Called from
# tmux hooks on window-create/close and from the shell on SIGWINCH.
#
# window-status-format is a WINDOW option in this tmux build, so the value
# is set per window (by window_id) rather than per session or globally.
# A session's current window can change between iterations without issue,
# since nothing here depends on the "current" target.

MAX_WIDTH=20
MIN_WIDTH=5

max() { test "$1" -gt "$2" && printf '%d' "$1" || printf '%d' "$2"; }
min() { test "$1" -lt "$2" && printf '%d' "$1" || printf '%d' "$2"; }

for session in $(tmux list-sessions -F '#{session_id}'); do
	# Snapshot this session's windows once; the list is stable during
	# the set-option calls even if the user switches sessions/windows.
	windows=$(tmux list-windows -t "$session" -F '#{window_id}')
	n_windows=$(printf '%s\n' "$windows" | grep -c .)
	test "$n_windows" -gt 0 || continue

	win_width=$(tmux display-message -t "$session" -p '#{window_width}' 2>/dev/null)
	test -n "$win_width" || win_width=80

	width=$(( (win_width - 30) / n_windows ))
	width=$(min "$width" "$MAX_WIDTH")
	width=$(max "$width" "$MIN_WIDTH")

	body="#{?automatic-rename,#{window_index}:#{=$width:#{pane_title}},#{=$width:#{window_name}}}"
	for wid in $windows; do
		tmux set-option -w -t "$wid" window-status-current-format "#F$body"
		tmux set-option -w -t "$wid" window-status-format "#{?client_prefix,#[reverse],}#F$body"
	done
done
