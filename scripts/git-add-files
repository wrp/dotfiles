#!/bin/sh

# Add each file listed on the command line with auto-generated
# commit messages.

cleanup_docker_corruption() {
	# When running on both docker and outside, the repos seem to get corrupt
	# in such a way that `git status` cleans it up.  (That is, git diff-index
	# will fail until `git status` is run in that environment.)  So run
	# git status to "uncorrupt" the repo.  Terrible hack.
	git status > /dev/null
}

validate_args() {
	reset_trailer_args "$@"
}

reset_trailer_args() {
	# We pass arguments directly to git add, but git-add does not
	# recognize --trailer.  So we look for --trailer arguments
	# and pass them through the environment in t via exec
	unset get_next need_to_exec
	for x; do
		shift
		if test -n "${get_next+set}"; then
			t=${t+$t,}$x
			unset get_next
			continue
		fi
		case $x in
		--trailer=*)
			t=${t+$t,}${x#--trailer=};
			need_to_exec=1;;
		--trailer)
			get_next=1;
			need_to_exec=1;;
		*) set -- "$@" "$x"
		esac
	done
	if test -n "$need_to_exec"; then
		t=$t exec "$0" "$@"
	fi
}

generate_subject() {
	git diff --name-only --cached | perl -0777 -nE 'chomp; my $msg = "Add " . join(", ", split(/\n/));
		my $max = '"${MAX_GIT_SUMMARY-50}"';
		if (length $msg > $max) { substr($msg, $max - 3) = "..." }
		say substr($msg, 0, '"${MAX_GIT_SUMMARY-50}"') . "\n"'
}

main() {
	validate_args "$@"
	cleanup_docker_corruption

	if test -n "$1"; then
		git add "$@" || exit
	else
		while read line; do
			git add "$line" || exit
		done
	fi
	count=$(git diff-index --cached --name-only HEAD "$@" | wc -l)
	{
		if test "$count" -ne 1; then
			generate_subject
		fi
		git diff --name-status --cached \
			| sed -e 's/^A/Add/; s/^M/Modify/' \
			| if test "$count" -eq 1; then tr '\t' ' '; else expand -t 7; fi
		echo
		git diff --stat --cached \
		| perl -nE "chomp; say substr \$_, 0, ${MAX_GIT_WIDTH-72} - 1"
	} | SKIP_MESSAGE_CHECK=1 SKIP_SPELLCHECK=silent git commit -F -
}

main "$@"
