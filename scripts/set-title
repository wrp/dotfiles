#!/bin/sh

MAX_WIDTH=20
MIN_WIDTH=5

# Set the title of the tmux or terminal window

# In an interactive shell, this script will be invoked by the debug_trap
# for each command in a pipeline.  So far, I've seen it consistently
# called in order (so for 'foo | bar | less', the less will be invoked
# last.)  I do not want "less" in the title for the pipeline, so punt
test "$1" = less && exit

# The expectation is that we're running in TMUX or docker.  For the moment,
# we can use terminal escape sequences from docker images I often
# run.  Cannot use escape sequences from Apple terminal directly,
# but I don't really care about that.  Abort early and call it a success
# if we aren't in one of the expected environments.
test -z "$TMUX$DOCKER" && exit

# If no argument is given, use the root of the git repo.
# If not in a git repo, use the output of pwd -P
test -z "$*" && {
	if test "$(pwd -P)" = "$HOME"; then
		d=${HOME_PANE_TITLE-~}
	elif branch_name=$(git rev-parse --abbrev-ref HEAD); then
		d="$(git rev-parse --show-toplevel)"
	else
		d="$(pwd -P | sed -e "s@$HOME@~@")"
	fi
	set -- "$(basename "$d")"
} 2> /dev/null

max() { test "$1" -gt "$2" && printf '%d' "$1" || printf '%d' "$2"; }
min() { test "$1" -lt "$2" && printf '%d' "$1" || printf '%d' "$2"; }

window_count=$(tmux list-windows | wc -l)
test "$window_count" -gt 0 || exit  # protect against tmux not being in PATH
width=$(min "$(( (${COLUMNS:-80} - 30) / $window_count ))" "$MAX_WIDTH")

width=$(max "$width" "$MIN_WIDTH")
width_minus_1=$(( $width - 1 ))

if test -n "$truncate_left"; then
	patt='.*\(.\{'"$width_minus_1"'\}\)'
	repl='<\1'
else
	patt='\(.\{'"$width_minus_1"'\}\).*'
	repl='\1>'
fi

title="${DOCKER+$DOCKER:}$(
	echo "${marker+$marker$marker }$*${marker+ $marker$marker}" |
	sed '/.\{'"$width"'\}/s/^'$patt'$/'$repl/ )"



# Instead of renaming the window,  we will change the title of the current pane and
# rely on the tmux configuration to set the string shown in the status bar via
# the automatic-rename-format
if test -n "$TMUX"; then
	if test -n "$FORCE"; then
		echo 'WARNING: window renamed.  Auto-rename is now disabled' >&2
		tmux rename-window -- "$title"
	else
		tmux select-pane -t ${TMUX_PANE} -T "$title"
	fi
else
	printf '\033k%s\033\' "$title"
fi

exit

# Some additional context from opencode (ollama qwen3.8:27b), explaining how the osc sequence that sets
# the terminal title gets to the display:
#
#      Two different things in tmux: the window name and the pane title. Here's what's happening:
#
#      1. opencode sets the pane title, not the window name. TUIs like opencode emit a standard xterm title escape sequence (ESC ] 2; <title> BEL) on the pane's tty. tmux intercepts that (any app's)
#         and stores it as the pane's title, which appears as #{pane_title} in formats. This happens unconditionally — it's just how tmux handles OSC titles on a pane.
#
#      2. Your config is what makes it visible. Your status bar format is doing the display (~/.tmux.conf:17):
#         #F#{?automatic-rename,#{window_index}:#{pane_title},#{window_name}}
#         With automatic-rename on (:63), tmux deliberately renders #{pane_title}. So the title you see as "the window title" is actually the pane title.
#
#      3. allow-rename off (:62) means opencode is NOT touching your window name — that option specifically controls whether an app's title sequence propagates to the window name (and disables your
#         automatic-rename). In your case the window name is protected; only the pane title is being set, which is what your format intentionally shows.
