# Git related interactive functions

g() {
	local arg cwd orig prev version verbose=$V top raw=''

	version=$(command git --version) || return
	if test -n "$EXPECTED_GIT_VERSION" &&
		test "$version" != "$EXPECTED_GIT_VERSION"
	then
		(die Unexpected git version: $version)
		return 1
	fi

	test $# = 0 && { set -- info; }

	# Do aliasing on arguments, but not for config.
	# It is common to set integer values, and those should not
	# be aliased to branch names.  And I see no reason to ever
	# want any of these other aliases for config.
	if test $1 != config && test $1 != clone; then
	for arg; do
		shift
		orig=$arg

		if test -z "$raw"; then
		# replace numeric args with branch name
		case $arg in
		(--    ) raw=1; continue;;
		(*)
			if test "$prev" != -n &&
				! arg=$(
					perl -e '
						($s=shift) =~ s{(?<![~\w])(\d+)(?![~\w])|\{(\d+)\}}
						{my $r=qx{git select-branch "$1$2"};
						die "Cannot find branch" if $?; chomp $r; $r}ge;
						print $s
					' -- "$arg"
				)
			then
				return 1
			fi
		esac
		fi

		test "$arg" != "$orig" && verbose=1
		set -- "$@" "$arg"
		prev=$orig
	done
	fi

	case $1 in
	(cd    )
		shift
		top=$(command git show-worktree "$@") \
		&& cwd=${PWD#$(command git rev-parse --show-toplevel)} \
		&& cd "$top$cwd" \
		&& echo "Changed directory to $top$CYAN$cwd"  \
		;
		return;;
	(clone ) shift; set -- clone-wrapper "$@";;
	(.     ) set -- info;;
	esac
	test "${verbose:-0}" -eq 0 2> /dev/null || echo "git $*"

	command git "$@"
}
for cmd in ga gdm; do
eval "$cmd() { echo 'OBSOLETE: Use g ${cmd#g} instead' >&2; return 1; }"
done
