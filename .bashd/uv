

uv() {
	if test -z "$UV_CACHE_DIR"; then
		echo "Stubbornly refusing to run unless you specify UV_CACHE_DIR" >&2
		return 1
	fi
	if test -z "$UV_ALLOW_CACHE_ON_ROOT" &&
			! _on_different_devices "$UV_CACHE_DIR" /; then
		echo "Stubbornly refusing to run with cache on root partition" >&2
		return 1
	fi
	command uv "$@"
}
