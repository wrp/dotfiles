cd() {
	local status path
	if test $# -gt 1; then
		echo 'cd takes at most one argument' >&2
		return 1
	fi
	local _dir=${1-$(tmux display-message -p '#{session_path}' | sed 1q)}

	command cd "${_dir:-$HOME}" || return
	path=$(pwd -P) || return
	if
		test -n "$VIRTUAL_ENV" \
		&& test "${path#${VIRTUAL_ENV%/.venv}}" = "$path"
	then
		printf 'You are outside the scope of venv.  Deactivating.  To re-enter: '
		printf 'source %s\n' "${VIRTUAL_ENV}/bin/activate"
		deactivate
	fi >&2

	if test -f .node-version || test -f .nvmrc || test -f package.json; then
		fnm use --silent-if-unchanged 2> /dev/null
	fi
}
cdm() { cd $(FULL_PATH=1 get-modified-files | longest-common-prefix -d); }
gcd() {
	local _dir
	_dir=$(FULL_PATH=1 get-modified-files $1 | get-most-used-dir)
	test -d "$_dir" || _dir=$(dirname "$_dir")
	if test -d "$_dir"; then
		cd "$_dir"
		pwd
	else
		echo "$_dir is not a directory" >&2
	fi
}
