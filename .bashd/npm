

npm() {
	echo "NOOO!!  Do not use npm.  Use pnpm instead" >&2; return 1
	if test -z "$NPM_CONFIG_CACHE"; then
		echo "Stubbornly refusing to run unless you specify NPM_CONFIG_CACHE" >&2
		return 1
	fi
	if test -z "$NPM_ALLOW_CACHE_ON_ROOT" &&
			! _on_different_devices "$NPM_CONFIG_CACHE" /; then
		echo "Stubbornly refusing to run with cache on root partition" >&2
		return 1
	fi
	command npm "$@"
}


pnpm() {
	for n in PNPM_CONFIG_STORE_DIR PNPM_CONFIG_CACHE_DIR; do
		if eval "test -z \"\$$n\""; then
			echo "Stubbornly refusing to run since $n is not set" >&2
			return 1
		fi
		if ! eval "_on_different_devices \"\$$n\" /"; then
			echo "Stubbornly refusing to run with $n on root partition" >&2
			return 1
		fi
	done
	command pnpm "$@"


}
