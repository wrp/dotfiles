

yarn() {
	if test -z "$YARN_CACHE_FOLDER"; then
		echo "Stubbornly refusing to run unless you specify YARN_CACHE_FOLDER" >&2
		return 1
	fi
	if test -z "$YARN_ALLOW_CACHE_ON_ROOT" &&
			! _on_different_devices "$YARN_CACHE_FOLDER" /; then
		echo "Stubbornly refusing to run with cache on root partition" >&2
		return 1
	fi
	command yarn "$@"
}
